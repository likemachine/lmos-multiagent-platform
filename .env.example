# LMOS Runtime
LLM_PROVIDER=ollama
LLM_BASE_URL=http://SERVER_IP:11434
LLM_MODEL_NAME=llama3.2:latest

# PostgreSQL analyst agent
POSTGRES_HOST=SERVER_IP
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=change_me

# LMOS Runtime WebSocket endpoint
LMOS_RUNTIME_WS=ws://127.0.0.1:18081/subscriptions
